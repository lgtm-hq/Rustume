{
  "name": "@rustume/web",
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-wasm.js",
    "preview": "vite preview",
    "build:wasm": "cd ../../bindings/wasm && wasm-pack build --mode no-install --target web --out-dir ../../apps/web/wasm",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "oxlint --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "e2e:build": "node scripts/e2e-build.js",
    "e2e:server": "node scripts/e2e-build.js && vite preview --host 127.0.0.1 --port \"${E2E_PORT:-4173}\" --strictPort"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.11",
    "@lgtm-hq/turbo-themes": "^0.41.0",
    "@solidjs/router": "^0.16.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@thisbeyond/solid-dnd": "^0.7.5",
    "fuse.js": "^7.5.0",
    "postcss": "^8.5.8",
    "solid-js": "^1.9.12",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-solid": "^2.11.11",
    "workbox-window": "^7.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@solidjs/testing-library": "0.8.10",
    "@testing-library/jest-dom": "7.0.1",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.2",
    "@vitest/coverage-istanbul": "4.1.10",
    "axe-core": "4.12.1",
    "jsdom": "30.0.1",
    "oxlint": "1.76.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "vitest-axe": "0.1.0",
    "fake-indexeddb": "6.2.5"
  },
  "peerDependencies": {
    "typescript": "^7.0.0"
  },
  "overrides": {
    "playwright-core": "1.62.1",
    "typescript": "7.0.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@babel/plugin-transform-modules-systemjs": "^8.0.0",
    "brace-expansion": "^5.0.8",
    "fast-uri": "^4.1.1",
    "astro": "^7.1.0",
    "esbuild": "^0.28.1",
    "h3": "2.0.1-rc.26",
    "sharp": "^0.35.0",
    "ws": "^8.21.0"
  }
}

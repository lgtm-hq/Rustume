# Prettier has no built-in Astro parser and neither the lintro CI image nor a
# local install loads prettier-plugin-astro, so every .astro file would fail
# with "No parser could be inferred". The docs site's .astro components are
# type-checked by `astro check` (scripts/ci/site/check.sh, site-quality CI).
*.astro

# html-validate's recommended preset owns HTML style and requires an uppercase
# DOCTYPE and omitted void end tags (`<meta ...>`). Prettier always prints
# `<!doctype html>` and `<meta ... />` and has no option for either, so the two
# tools cannot both pass on the same file. apps/web/index.html is the only one.
*.html

